mlruns/
mlruns.db
mlartifacts/

# Model pickles are git-ignored but explicitly COPY'd in the Dockerfile;
# the general COPY . . would miss them, so we do NOT ignore ML/ here.

# Generated / temp
pics/
visualizations/
*.log
*.bak
*.tmp

# OS
Thumbs.db
.DS_Store

# Docs not needed at runtime
docs/
*.md
!README.md

# Tests not needed at runtime
tests/
