%% c9r v0.8 – BI Reference Architecture
flowchart TB

%% ───── Source layer ─────
subgraph Source_Systems["Source systems"]
    direction LR
    lblink["HTTP/lblink\n• ListenBrainz listen JSON\n• artist, track, release,\n  listened_at, artist_mbid"]
    lfAPI["HTTP/lfAPI\n• Last.fm scrobble JSON\n• Artist, Album, Song,\n  uts, artist_mbid"]
    mbAPI["HTTP/mbAPI\n• MusicBrainz artist JSON\n• alias, comment, country"]
    mbDocker["Local MB mirror\n• Docker PostgreSQL\n• Unlimited query throughput"]
    userCLI["Click CLI\n• c9r canon human\n• c9r enrich --country"]
end

%% ───── Integration / Staging layer ─────
subgraph Staging["Integration layer  ➜  Python ELT (Click CLI + helpers)"]
    direction LR
    extract["Extract"] --- transform["Transform\n(normalise_scrobble_df)\n(fix_encoding)"] --- load["Load\n(append_to_parquet)\n(year‑partitioned)"]
end

%% ───── Data‑storage layer ─────
subgraph DWH["Data‑storage layer  ➜  Parquet store (zstd) + DuckDB query layer"]
    direction LR
    pqstore["PQ/ Parquet files\n─────────────────────\n• scrobble/year=YYYY/  (fact, partitioned)\n• artist_info.parquet  (dim)\n• avc.parquet          (dim, canonisation)\n• gs_mb.parquet        (gold standard)\n• predictions_log.parquet (drift monitoring)\n• qa_report.parquet    (QA history)\n• uc.parquet           (user country)\n• c.parquet            (country codes)"]
    duckdb["helpers/query.py\n──────────────────\nDuckDB‑over‑Parquet\n• top_artists / albums / tracks\n• monthly_scrobble_counts\n• yearly_top_n_artists\n• listening_clock\n• artist_country_stats\n• canonical_name CTE"]
    pqstore --- duckdb
end

%% ───── ML layer ─────
subgraph MLPipeline["ML pipeline"]
    direction TB
    features["Feature engineering\nhelpers/features.py + inference.py\n• 3‑tier: whole‑string / token / char\n• interaction terms\n• catalogue (disco + melo)\n→ ~63 raw, pruned to 41"]
    training["Training + tuning\ncorefunc/canon/trainer.py\ncorefunc/canon/tuner.py\n• k‑fold CV, MLflow tracking\n• Optuna precision‑biased search"]
    lgbm["LightGBM pipeline\nML/lightgbm_best.pkl\n(RobustScaler → LGBMClassifier)"]
    fastapi["FastAPI model server\ncorefunc/model_server.py\n/predict  /predict_batch  /health"]
    drift["Drift detection\ncorefunc/qa.py → qa_predictions()\n• mean probability shift\n• ambiguous‑band proportion\n• feature quantile drift"]
    features --> training --> lgbm
    lgbm --- fastapi
    lgbm --> drift
end

%% ───── Schema management ─────
subgraph SchemaLayer["Schema management"]
    schema["helpers/schema.py\n• Versioned SCHEMA_REGISTRY\n• Auto‑stamp on write\n• Validate on read\n• c9r schema show / migrate"]
end

%% ───── QA layer ─────
subgraph QALayer["Quality assurance"]
    qa["corefunc/qa.py\n• Schema / null / timestamp / dup checks\n• MBID validation\n• Encoding sanity\n• Prediction drift monitoring\n• Reports → qa_report.parquet"]
end

%% ───── Output / analytics layer ─────
subgraph Output["Output layer  ➜  Analytical views (DuckDB)"]
    star["Dimensional views\n• fact: scrobble (partitioned by year)\n• dim: artist_info (MBID, country, aliases)\n• dim: avc (variant → canonical mapping)\n• dim: uc (user country periods)\n• dim: c (country codes)"]
end

%% ───── Front‑end / analytics layer ─────
subgraph Frontend["Frontend  ➜  Click CLI"]
    dashboard["c9r dashboard\n• artist / album / track / recent / yearly"]
    profile["c9r profile\n• overview / top / timeline / streaks\n• clock / companions / countries\n• population / where / uc / variants"]
    canonUI["c9r canon\n• human (interactive review)\n• machine (ML‑assisted discovery)"]
end

%% ───── Metadata side‑rail ─────
subgraph Metadata["Metadata management"]
    mapping["Column mapping\n Artist → artist_name\n Album  → album_title\n Song   → track_title\n uts    → play_time (UTC)"]
end

%% ───── Orchestration ─────
