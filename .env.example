# ── Last.fm ────────────────────────────────────────
LASTFM_API_KEY=YOUR_LASTFM_KEY_HERE
LASTFM_SESSION_KEY=
LASTFM_USER=YOUR_USERNAME_HERE_IF_YOU_WANT_TO_DEFAULT_SAVING_YOURSELF_A_COUPLE_OF_SECONDS
APPLICATION_NAME=CanonFodder

# ── Music- and ListenBrainz ────────────────────────
MB_APP_NAME=CanonFodder
MB_APP_VERSION=1.2
MB_CONTACT=balazs.torda@iu-studies.org
TOKEN=
MB_USERNAME=YOUR_MB_USERNAME_ONLY_NEEDED_FOR_WRITE_REQUESTS
MB_PASSWORD=YOUR_MB_PASSWORD_ONLY_NEEDED_FOR_WRITE_REQUESTS

# ── Database connection ────────────────────
DB_URL=mysql+pymysql://user:pass@localhost:3307/canonfodder

# ── Prefect configuration ────────────────────
# Optional: Set the Prefect API URL for connecting to a Prefect server
# If not set, Prefect will use the local SQLite database
# PREFECT_API_URL=http://localhost:4200/api

# Optional: Set the Prefect API key for authentication
# PREFECT_API_KEY=your-api-key-here

# Optional: Set the work pool name for deployments
# PREFECT_DEFAULT_WORK_POOL_NAME=default

# Optional: Enable or disable Prefect telemetry
# PREFECT_TELEMETRY_ENABLED=false
